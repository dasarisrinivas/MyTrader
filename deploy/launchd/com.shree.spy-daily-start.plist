<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.shree.spy-daily-start</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/svss/Documents/code/ShreeBot/.venv/bin/python3</string>
        <string>/Users/svss/Documents/code/ShreeBot/scripts/run_daily.py</string>
        <string>start</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/svss/Documents/code/ShreeBot</string>

    <!-- Weekdays Mon(1)–Fri(5) at 08:00 local (machine is Central Time). -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>/Users/svss/Documents/code/ShreeBot/logs/daily_scheduler.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/svss/Documents/code/ShreeBot/logs/daily_scheduler.err.log</string>

    <key>RunAtLoad</key>
    <false/>

    <!-- AUG 4 2026 — ROOT CAUSE of the unattended-start failure.
         run_daily.py exits as soon as start_spy_options.sh returns, and by
         default launchd then tears down the job's entire process group, taking
         the backgrounded bot with it. Observed on 2026-08-03 (start 08:00:06,
         SIGTERM 08:00:13) and 2026-08-04 (start 08:00:03, SIGTERM 08:00:06) —
         the bot died ~3-7s after every scheduled start, and the sessions only
         traded because of a manual restart.
         `nohup` does NOT protect against this: it masks SIGHUP, but launchd
         sends SIGTERM. AbandonProcessGroup tells launchd to leave the
         descendants alone when the job exits. -->
    <key>AbandonProcessGroup</key>
    <true/>
</dict>
</plist>
