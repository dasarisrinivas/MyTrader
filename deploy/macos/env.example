# MyTrader macOS automation settings — copied by install.sh to ~/.mytrader/env
# NON-SECRET settings only. Secrets live in the macOS Keychain
# (deploy/macos/bin/credentials.sh setup).

# --- IB connection ---------------------------------------------------------
IBKR_HOST=127.0.0.1
IBKR_PORT=4002              # 4002 = Gateway paper, 4001 = Gateway live
TRADING_MODE=paper          # paper | live  (must match the port above)

# --- IBC / IB Gateway ------------------------------------------------------
IBC_PATH=/opt/ibc           # where IBC is installed
#TWS_VERSION=1030           # auto-detected from ~/Applications/ibgateway if unset
#IB_GATEWAY_DIR=            # auto-detected if unset

# --- Bot -------------------------------------------------------------------
#CONFIG_FILE=config.yaml
#MYTRADER_SIMULATION=1      # 1 = --simulation (no real orders)
#BOT_ARGS=--reset-state
#MAX_CONTRACTS=5
#PYTHON_BIN=                # defaults to <project>/.venv/bin/python, then python3

# --- Health / watchdog -----------------------------------------------------
API_WAIT_TIMEOUT=600        # boot: max seconds to wait for the IB API
API_PROBE_EVERY_N=5         # deep API probe every Nth watchdog run (N*60s)
HEALTHCHECK_CLIENT_ID=97
BOOTVERIFY_CLIENT_ID=98

# --- Telegram fallback (prefer Keychain; only use these if you accept
#     plaintext-on-disk for the notification bot) -----------------------
#TELEGRAM_BOT_TOKEN=
#TELEGRAM_CHAT_ID=
