<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mytrader.ibgateway</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__DEPLOY_DIR__/bin/start_ibgateway.sh</string>
    </array>

    <!-- Start at login, restart whenever the process exits (crash OR the
         gateway's own daily restart cycle). -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- Don't thrash if the gateway crash-loops (bad credentials etc.) -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- IB Gateway is a GUI app: needs the Aqua (logged-in) session. -->
    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>WorkingDirectory</key>
    <string>__PROJECT_ROOT__</string>

    <key>StandardOutPath</key>
    <string>__PROJECT_ROOT__/logs/launchd/ibgateway.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_ROOT__/logs/launchd/ibgateway.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
