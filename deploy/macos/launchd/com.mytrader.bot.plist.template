<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mytrader.bot</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__DEPLOY_DIR__/bin/start_bot_service.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- KeepAlive only while the kill-switch flag file exists. Removing
         ~/.mytrader/trading.enabled (stop_trading.sh) stops all restarts. -->
    <key>KeepAlive</key>
    <dict>
        <key>PathState</key>
        <dict>
            <key>__HOME__/.mytrader/trading.enabled</key>
            <true/>
        </dict>
    </dict>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>LimitLoadToSessionType</key>
    <string>Aqua</string>

    <key>WorkingDirectory</key>
    <string>__PROJECT_ROOT__</string>

    <key>StandardOutPath</key>
    <string>__PROJECT_ROOT__/logs/launchd/bot.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_ROOT__/logs/launchd/bot.err.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
