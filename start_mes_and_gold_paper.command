#!/bin/bash
# Auto-launcher for MES paper bot + Gold paper bot
# Double-click this file in Finder to run both bots

cd "$(dirname "$0")"

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  Starting MES Paper Bot + Gold Paper Bot"
echo "  Directory: $PWD"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

echo ">>> Starting MES Paper Bot..."
bash start_paper_bot.sh
echo ""

echo ">>> Starting Gold Paper Bot..."
bash start_paper_gold.sh
echo ""

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  Done! Both bots should now be running."
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
